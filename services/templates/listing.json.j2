{
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  {#- name = <provider>/<bare> per the platform service-naming convention
      (unitysvc PR #1196 / issue #1138). #}
  "name": "{{ provider_name }}/{{ offering_name }}",
{%- if list_price %}
{#- Price-cell copy follows the marketplace description grammar
    (unitysvc/unitysvc#1886, PR #1887):

        <amount> [ ~<intent> <PILL> ] [ | <hover note> ]

    BYOK is *why* the gateway price is free, so it rides the badge slot and
    renders as a pill beside the amount. A bare `~` selects the default
    intent — a saving — which is the green fill; `~deal` / `~coupon` /
    `~info` are the other registers. The provider's reference rates ride the
    `|` note: that slot is taken first and consumed to end-of-string, so
    everything in it is inert — a rate card may contain "/" and "per"
    without being re-parsed as a unit.

    Composed here rather than written into the param file because
    scripts/update_params.py rebuilds list_price on the nightly populate run
    and would drop a hand-edited description within a day. #}
{%- set _rate = (' | usage is billed by ' ~ provider_display_name ~ ' directly at ' ~ pricing_note) if pricing_note else '' %}
  "list_price": {{ dict(list_price, description='Free ~ BYOK' ~ _rate) | tojson }},
{%- endif %}
  "user_access_interfaces": {
    "provider_api": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/{{ provider_name }}",
      "routing_key": {"model": "{{ offering_name }}"}
    }
  },
  "documents": {
    "How to use this model": {
      "$doc_preset": "llm_description"
    },
    "Python code example": {
      "$doc_preset": "llm_code_example_openai", "meta": {"sleep_after_test": 5}
    },
    "Python code example (Anthropic-style input)": {
      "$doc_preset": "llm_code_example_anthropic_to_openai_sdk", "meta": {"sleep_after_test": 5}
    },
    "cURL code example (Anthropic-style input)": {
      "$doc_preset": "llm_code_example_anthropic_to_openai_shell", "meta": {"sleep_after_test": 5}
    },
    "Python function calling code example": {
      "$doc_preset": "llm_code_example_fc_requests", "meta": {"sleep_after_test": 5}
    },
    "JavaScript code example": {
      "$doc_preset": "llm_code_example_javascript", "meta": {"sleep_after_test": 5}
    },
    "cURL code example": {
      "$doc_preset": "llm_code_example_shell", "meta": {"sleep_after_test": 5}
    },
    "Connectivity test": {
      "$doc_preset": "llm_connectivity", "meta": {"sleep_after_test": 5}
    },
    "Default request body": {
      "$doc_preset": "llm_request_template"
    }
  }
}
